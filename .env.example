# AI B超报告书写助手 — 环境配置
# 复制为 .env 并填入密钥: cp .env.example .env
# 百炼控制台: https://bailian.console.aliyun.com/

# —— 百炼通用（LLM / ASR 可共用同一 Key）——
DASHSCOPE_API_KEY=
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# —— LLM 结构化抽取 ——
# 未设置时自动回退 DASHSCOPE_API_KEY
MEDICAL_LLM_API_KEY=
MEDICAL_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEDICAL_LLM_MODEL=qwen-plus
MEDICAL_LLM_TEMPERATURE=0.1
MEDICAL_LLM_MAX_TOKENS=4096
MEDICAL_LLM_TIMEOUT=120

# —— ASR 语音转写 ——
# 未设置时自动回退 MEDICAL_LLM_API_KEY / DASHSCOPE_API_KEY
MEDICAL_ASR_API_KEY=
MEDICAL_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEDICAL_ASR_MODEL=qwen3-asr-flash
MEDICAL_ASR_TIMEOUT=60

# —— 服务端口 ——
MEDICAL_PORT=8900
